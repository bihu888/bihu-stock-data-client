# bihu-stock-data-client 配置模板
# 复制为 .env 并填入真实值；已存在的环境变量优先级更高
# API Key 请前往 https://stock.bihu888.cn 注册获取
BIHU_STOCK_DATA_API_KEY=your-api-key

# 服务端地址（默认线上服务；本地联调时改成本地 Java 服务地址）
# BIHU_STOCK_DATA_BASE_URL=https://stock.bihu888.cn/stock/data
# BIHU_STOCK_DATA_BASE_URL=http://localhost:9800/stock/data
